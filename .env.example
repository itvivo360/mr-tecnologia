APP_NAME="Mr Tecnología"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tienda
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=America/Santiago

# Pagos: "mercadopago" o "fake" (simula aprobación, solo para desarrollo)
PAYMENT_GATEWAY=fake
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Secreto de firma de webhooks (Tus integraciones > Webhooks > Clave secreta)
MERCADOPAGO_WEBHOOK_SECRET=
# Minutos que una orden pendiente mantiene reservado el stock
ORDER_RESERVATION_MINUTES=30

# Soporte técnico (turnos): valores iniciales, editables en Backoffice > Configuración > Agenda de soporte
SUPPORT_OPEN_HOUR=9
SUPPORT_CLOSE_HOUR=18
SUPPORT_SLOT_MINUTES=60
SUPPORT_SLOT_CAPACITY=1
SUPPORT_WORKING_DAYS=1,2,3,4,5
SUPPORT_BOOKING_HORIZON_DAYS=30

# Sitio público: VALORES INICIALES. Después se administran en Backoffice > Configuración
# (lo guardado ahí tiene prioridad sobre estas variables). Los campos vacíos no se muestran.
SITE_NAME="Mr Tecnología"
SITE_TAGLINE="Equipos, redes y soporte técnico para tu casa y tu negocio."
# WhatsApp: solo dígitos con código de país, ej. 56912345678
SITE_WHATSAPP=
SITE_WHATSAPP_MESSAGE="Hola, quiero hacer una consulta."
SITE_PHONE=
SITE_EMAIL=
SITE_ADDRESS=
SITE_MAPS_URL=
SITE_HOURS="Lunes a viernes, 9:00 a 18:00"
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_TIKTOK=
SOCIAL_YOUTUBE=
SOCIAL_LINKEDIN=
SOCIAL_X=
